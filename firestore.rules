rules_version = '2';

// GCC — Firestore Security Rules.
//
// Clients read; the server writes. Every write is denied here, permanently.
// All mutations run through Next.js server code with the Firebase Admin SDK.
// Reads follow the least-privilege table in docs/02-DATA-MODEL.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.role == 'super_admin';
    }

    // Cancelled is deliberately NOT public: it is a terminal state whose
    // records stay readable only to the owner and the Super Admin (and to
    // server-rendered notice pages). ADR-044 documents this revision.
    function isPublicTournamentStatus(status) {
      return status in [
        'registration_open',
        'registration_closed',
        'pots_confirmed',
        'fixtures_published',
        'league_phase',
        'knockout',
        'completed',
        'archived'
      ];
    }

    function isPublishedTournamentStatus(status) {
      return status in [
        'fixtures_published',
        'league_phase',
        'knockout',
        'completed',
        'archived'
      ];
    }

    function tournamentPath(tournamentId) {
      return /databases/$(database)/documents/tournaments/$(tournamentId);
    }

    function tournamentExists(tournamentId) {
      return exists(tournamentPath(tournamentId));
    }

    function tournamentData(tournamentId) {
      return get(tournamentPath(tournamentId)).data;
    }

    function isPublicTournament(tournamentId) {
      return tournamentExists(tournamentId) &&
        isPublicTournamentStatus(tournamentData(tournamentId).status);
    }

    function isPublishedTournament(tournamentId) {
      return tournamentExists(tournamentId) &&
        isPublishedTournamentStatus(tournamentData(tournamentId).status);
    }

    function isTournamentOwner(tournamentId) {
      return signedIn() &&
        tournamentExists(tournamentId) &&
        tournamentData(tournamentId).ownerUid == request.auth.uid;
    }

    // Private profile: owner or Super Admin.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == uid;
      }

      // "My Tournaments" membership snapshots are owner-read only.
      match /memberships/{tournamentId} {
        allow read: if signedIn() && request.auth.uid == uid;
      }
    }

    // Public display profile and its public career history.
    match /publicProfiles/{uid} {
      allow read: if true;

      match /history/{tournamentId} {
        allow read: if true;
      }
    }

    // Public organiser identity. Created and edited by the server only, so the
    // owner cannot bypass validation or invent another organiser's profile.
    match /organiserProfiles/{uid} {
      allow read: if true;
    }

    // Gamer-tag reservation: server-only on both read and write.
    match /gamerTags/{gamerTagLower} {
      allow read: if false;
    }

    // Tournament slug reservation: server-only on both read and write. The
    // document id is the slug; clients learn slugs from tournament documents.
    match /tournamentSlugs/{slug} {
      allow read: if false;
    }

    // Applicant or Super Admin only.
    match /adminApplications/{applicationId} {
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    // One server-written marker per applicant. It enforces the one-pending and
    // rejection-cooldown rules, so no client may read or write it.
    match /applicationState/{uid} {
      allow read: if false;
    }

    // Tournaments are public once they leave draft and are neither suspended
    // nor cancelled. Owners and the Super Admin always see their own records.
    match /tournaments/{tournamentId} {
      allow read: if isPublicTournamentStatus(resource.data.status) ||
        (signedIn() && resource.data.ownerUid == request.auth.uid) ||
        isSuperAdmin();

      match /registrations/{uid} {
        allow read: if isPublicTournament(tournamentId) ||
          isTournamentOwner(tournamentId) ||
          isSuperAdmin();
      }

      // Draw is private until confirmed; afterwards it is public with the event.
      match /draw/{drawId} {
        allow read: if isTournamentOwner(tournamentId) ||
          isSuperAdmin() ||
          (isPublicTournament(tournamentId) &&
            resource != null &&
            resource.data.confirmedAt != null);
      }

      // Unpublished fixture drafts stay private.
      match /fixtureDrafts/{draftId} {
        allow read: if isTournamentOwner(tournamentId) || isSuperAdmin();
      }

      // Fixtures become public once the tournament reaches fixtures_published.
      match /matches/{matchId} {
        allow read: if isPublishedTournament(tournamentId) ||
          isTournamentOwner(tournamentId) ||
          isSuperAdmin();
      }

      // Informational matchday windows share the match visibility boundary.
      match /matchdays/{matchday} {
        allow read: if isPublishedTournament(tournamentId) ||
          isTournamentOwner(tournamentId) ||
          isSuperAdmin();
      }

      // Result reports are a player-to-admin "Report a problem" channel. They
      // are readable by the reporter, the tournament owner and the Super Admin.
      // They never change an official result; writes remain deny-all.
      match /resultReports/{reportId} {
        allow read: if isTournamentOwner(tournamentId) ||
          isSuperAdmin() ||
          (signedIn() && resource.data.reportedBy == request.auth.uid);
      }

      // Derived competition data is public only with a public tournament.
      match /standings/{uid} {
        allow read: if isPublicTournament(tournamentId) ||
          isTournamentOwner(tournamentId) ||
          isSuperAdmin();
      }

      match /knockoutTies/{tieId} {
        allow read: if isPublicTournament(tournamentId) ||
          isTournamentOwner(tournamentId) ||
          isSuperAdmin();
      }

      match /announcements/{announcementId} {
        allow read: if isPublicTournament(tournamentId) ||
          isTournamentOwner(tournamentId) ||
          isSuperAdmin();
      }
    }

    // Platform-wide announcements. Public readers see only published,
    // unexpired, non-deleted notices. Drafts and soft-deleted records remain
    // Super-Admin-readable for the console (which uses the Admin SDK anyway).
    match /announcements/{announcementId} {
      allow read: if isSuperAdmin() ||
        (
          (!('deletedAt' in resource.data) || resource.data.deletedAt == null) &&
          resource.data.publishedAt != null &&
          resource.data.publishedAt <= request.time &&
          (
            !('expiresAt' in resource.data) ||
            resource.data.expiresAt == null ||
            resource.data.expiresAt > request.time
          )
        );
    }

    // The single platform settings document is Super Admin-only. Public pages
    // receive the three safe fields through a server helper, never a client read.
    match /platformSettings/{documentId} {
      allow read: if isSuperAdmin();
    }

    // Permanent champions and records.
    match /hallOfFame/{entryId} {
      allow read: if true;
    }

    // Super Admin-only operational records.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
    }

    match /platformStats/{documentId} {
      allow read: if documentId == 'summary' && isSuperAdmin();
    }

    // Rate-limit counters are server-only.
    match /rateLimits/{key} {
      allow read: if false;
    }

    // Collection-group reads for player history. Every query must constrain
    // tournamentId so the rules engine can prove that draft, suspended and
    // otherwise hidden tournaments are excluded. A broad cross-tournament
    // query fails rather than leaking a hidden tournament's documents.
    match /{path=**}/matches/{matchId} {
      allow read: if isPublishedTournament(resource.data.tournamentId) ||
        isTournamentOwner(resource.data.tournamentId) ||
        isSuperAdmin();
    }

    match /{path=**}/registrations/{uid} {
      allow read: if isPublicTournament(resource.data.tournamentId) ||
        isTournamentOwner(resource.data.tournamentId) ||
        isSuperAdmin();
    }

    // Permanent deny-all writes. No client role, including Super Admin, may
    // write directly to Firestore.
    match /{document=**} {
      allow write: if false;
    }
  }
}
