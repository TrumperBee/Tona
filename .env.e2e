# GCC E2E - committed dummy non-secret values for emulator-backed Playwright runs.
# NEVER point these at a real Firebase project.

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# Firebase public (dummy, emulator only)
NEXT_PUBLIC_FIREBASE_API_KEY=e2e-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gcc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gcc
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:e2e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin / emulators
FIREBASE_ADMIN_PROJECT_ID=demo-gcc
FIREBASE_ADMIN_CLIENT_EMAIL=e2e@example.com
FIREBASE_ADMIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC0\n-----END PRIVATE KEY-----
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Pinned super admin (matches QA seed)
SUPER_ADMIN_EMAIL=superadmin@gcc-test.example
SUPER_ADMIN_UID=e2e-super-admin

# Session
SESSION_COOKIE_MAX_AGE_DAYS=5

# Cloudflare Turnstile test keys (always pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# E2E harness switches (safe only with emulators + demo project)
GCC_E2E=1
NEXT_PUBLIC_GCC_E2E=1
CLOUDINARY_MODE=mock
GCC_E2E_CAPTURE_EMAIL=1
GCC_E2E_TURNSTILE_BYPASS=1
CSP_MODE=report-only

# Disable real integrations
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=e2e-unsubscribe-secret
NEXT_PUBLIC_APPCHECK_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_EHUBMARKET_URL=https://ehubmarket.me/
NEXT_PUBLIC_CONTACT_EMAIL=test@gcc-test.example
NEXT_PUBLIC_CONTACT_WHATSAPP=447700900000
