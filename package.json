{
  "name": "global-champions-circuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GCC — One Platform. Endless Competition.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore,auth \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "firebase emulators:exec --only firestore,auth \"vitest run --config vitest.integration.config.ts\"",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^13.10.0",
    "html-to-image": "^1.11.13",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "firebase-tools": "^15.35.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}