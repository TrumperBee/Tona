# ---------------------------------------------------------------------------
# GCC — environment variables
#
# Copy this file to .env.local and fill in the values for your environment.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never commit .env.local or any real secret.
#
# Firebase web app configuration (public, safe to expose).
# Find these in Firebase console → Project settings → Your apps.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Optional and unused for now: file storage is out of scope on the Spark plan.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Canonical public URL of this deployment, e.g. http://localhost:3000.
# Optional in development (falls back to http://localhost:3000). A production
# build fails if this is missing or invalid; use the real deployment origin
# with no trailing slash, e.g. https://tona-olive.vercel.app
NEXT_PUBLIC_SITE_URL=

# eHubMarket promotional link.
NEXT_PUBLIC_EHUBMARKET_URL=https://ehubmarket.me/

# Public contact channels. Leave blank until real channels exist; the Contact
# page then shows an honest "not configured" state instead of inventing one.
# Email address, e.g. hello@example.com
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only, e.g. 233201234567
NEXT_PUBLIC_CONTACT_WHATSAPP=

# ---------------------------------------------------------------------------
# SERVER ONLY — never expose these to the browser.
# Firebase service account (Firebase console → Project settings → Service accounts).
# ---------------------------------------------------------------------------

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=

# Keep escaped \n sequences; the Admin SDK converts them to real newlines.
FIREBASE_ADMIN_PRIVATE_KEY=

# The platform owner's email address. The only Super Admin.
# Never hardcode this address in source code.
SUPER_ADMIN_EMAIL=

# The same account's Firebase uid. The Super Admin role is granted only when
# BOTH this uid and SUPER_ADMIN_EMAIL match, so squatting the email address
# cannot elevate anyone. Find it in Firebase Console → Authentication → Users.
# Optional at boot; when missing or blank nobody receives super admin and the
# server logs one clear configuration error.
SUPER_ADMIN_UID=

# Session cookie lifetime in days (default: 5).
SESSION_COOKIE_MAX_AGE_DAYS=5

# ---------------------------------------------------------------------------
# Cloudinary - avatars only. Server-only; never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email delivery (Resend). Server-only; never prefix with NEXT_PUBLIC_.
# Missing values disable email without breaking in-app notifications.
# ---------------------------------------------------------------------------

# Resend API key. Leave blank in development to log rendered emails locally.
RESEND_API_KEY=
# Verified sender, e.g. GCC <notifications@yourdomain.com>. The domain must be
# verified in Resend before production mail will deliver.
RESEND_FROM=
# Signing secret for the Resend webhook (Svix). Starts with whsec_.
RESEND_WEBHOOK_SECRET=
# HMAC secret used to sign unsubscribe links. Use a long random value.
EMAIL_UNSUBSCRIBE_SECRET=
# Daily send cap. Normal mail stops at 80%; critical mail may use the rest.
EMAIL_DAILY_LIMIT=100
# Monthly reference used for the Super Admin 80% warning (Resend free tier is 3000).
EMAIL_MONTHLY_LIMIT=3000

# ---------------------------------------------------------------------------
# Bot protection and browser app integrity (Phase 18A).
# ---------------------------------------------------------------------------

# Cloudflare Turnstile site key (public) and secret (server only). Both are
# required in production: a missing secret fails closed. In development the
# widget is skipped with a console notice.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Firebase App Check reCAPTCHA v3 site key (public). A production build without
# it fails closed. In development, paste the debug token from Firebase Console
# → App Check → Apps → Manage debug tokens.
NEXT_PUBLIC_APPCHECK_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Content-Security-Policy response mode: report-only or enforce.
# Leave blank for production enforcement. Set to report-only for a staged
# rollout; rollback is the same one-line environment change.
CSP_MODE=

