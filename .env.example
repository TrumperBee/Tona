# ---------------------------------------------------------------------------
# GCC — environment variables
#
# Copy this file to .env.local and fill in the values for your environment.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never commit .env.local or any real secret.
#
# Firebase web app configuration (public, safe to expose).
# Find these in Firebase console → Project settings → Your apps.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Optional and unused for now: file storage is out of scope on the Spark plan.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Canonical public URL of this deployment, e.g. http://localhost:3000.
# Optional in development (falls back to http://localhost:3000). A production
# build fails if this is missing or invalid; use the real deployment origin
# with no trailing slash, e.g. https://tona-olive.vercel.app
NEXT_PUBLIC_SITE_URL=

# eHubMarket promotional link.
NEXT_PUBLIC_EHUBMARKET_URL=https://ehubmarket.me/

# Public contact channels. Leave blank until real channels exist; the Contact
# page then shows an honest "not configured" state instead of inventing one.
# Email address, e.g. hello@example.com
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only, e.g. 233201234567
NEXT_PUBLIC_CONTACT_WHATSAPP=

# ---------------------------------------------------------------------------
# SERVER ONLY — never expose these to the browser.
# Firebase service account (Firebase console → Project settings → Service accounts).
# ---------------------------------------------------------------------------

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=

# Keep escaped \n sequences; the Admin SDK converts them to real newlines.
FIREBASE_ADMIN_PRIVATE_KEY=

# The platform owner's email address. The only Super Admin.
# Never hardcode this address in source code.
SUPER_ADMIN_EMAIL=

# Session cookie lifetime in days (default: 5).
SESSION_COOKIE_MAX_AGE_DAYS=5
